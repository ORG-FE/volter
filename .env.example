# Volter server token (required, или используй CONNECTION_KEY для volter:// ссылки)
TOKEN=your-secret-token-here

# Альтернатива TOKEN: volter:// ссылка с сервером и токеном
# CONNECTION_KEY=volter://base64encodedjson

# Public IP of your server for client connection keys
PUBLIC_HOST=1.2.3.4

# TCP port for volter VPN (default: 25565)
VOLTER_PORT=25565

# QUIC listen port (default: 4433)
VOLTER_QUIC_PORT=4433

# Control panel port (default: 8088)
CONTROL_PORT=8088

# Server mode: tcp-only | quic-only | both (default: both)
SERVER_MODE=both

# Enable debug logging (default: false)
DEBUG=false

# Enable control panel (default: false)
CONTROL_PANEL=false
