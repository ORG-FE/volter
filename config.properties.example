# Volter Java server — рядом с server.jar, имя: config.properties
# Документация ключей: server/src/main/java/dev/c0redev/volter/Config.java

# Обязательно: TCP-порт(ы) VPN + встроенный HTTP (relay-index, dht find и т.д.)
listenPorts=25565


udpChannels=4

# Публичный хост для подсказок в индексах (можно пусто)
# publicHost=89.144.63.81

debug=false

# tcp-only | quic-only | both
serverMode=both

quicListenPort=4433
quicCertPath=quic/auto.crt
quicKeyPath=quic/auto.key

# HTTP-пути (по умолчанию совместимы с клиентом Android / Go relay)
# relayIndexFile=...   # если нужен статический JSON с диска
# relayIndexPath=/volter/relay-index.json
# dhtFindPath=/volter/dht/find
# dhtRpcListenUdp=0.0.0.0:25565
# dhtRpcSecret=   # optional, default = token
# Для p2p ICE mesh: у узлов в relayIndex/gossip должен быть dhtRpc=host:port этого UDP listener.
# gossipIndexPath=/volter/gossip-nodes.json

# Peer relay / QUIC retry (см. Config.java)
peerRelayEnabled=true
# quicRetryTokens=false
# relay.maxPerRemote=64
# relay.maxTotal=2048
# relay.maxBudgetKbps=10240

# Кластер серверов
# cluster.nodeId=ru-1
# cluster.listen=25565
# cluster.peers=de-1.example.com:25565,de-2.example.com:25565
# cluster.gossipIntervalMs=5000
# cluster.mapPath=/volter/cluster-map.json
# cluster.sessionsPath=/volter/cluster-sessions.json
# cluster.clientsPath=/volter/cluster-clients.json
# cluster.httpAuth=false
# cluster.httpSecret=
# Если httpAuth=true: GET cluster-map, cluster-sessions и cluster-clients только с заголовком X-Volter-Cluster-Key.
# Ожидаемое значение: cluster.httpSecret, иначе равен token сервера.
# Клиент Go/Android: те же пути и ключ можно задать в JSON protection профиля:
# clusterMapPath, clusterSessionsPath, clusterClientsPath, clusterHttpKey (см. internal/config ProtectionOptions).

# Обновления с GitHub (интервал не меньше 15 минут в коде)
update.enabled=false
update.repo=ORG-FE/volter
update.checkIntervalMinutes=60
update.restartExitCode=1
